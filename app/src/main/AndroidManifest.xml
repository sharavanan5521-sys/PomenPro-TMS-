<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Firebase needs the internet, shocking. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PomenPro">

        <!-- Login (Launcher) -->
        <activity
            android:name="com.example.pomenpro.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Register -->
        <activity
            android:name="com.example.pomenpro.RegisterActivity"
            android:exported="false" />

        <!-- Admin Dashboard -->
        <activity
            android:name="com.example.pomenpro.AdminDashboardActivity"
            android:exported="false" />

        <!-- Technician Dashboard -->
        <activity
            android:name="com.example.pomenpro.TechnicianDashboardActivity"
            android:exported="false"
            android:theme="@style/Theme.PomenPro" />

    </application>
</manifest>
